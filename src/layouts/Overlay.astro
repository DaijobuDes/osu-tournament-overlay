---
import MapInfomation from "../components/MapInfomation.astro";
import DifficultyStats from "../components/DifficultyStats.astro";
import ManiaStats from "../components/ManiaStats.astro";

import { isMania } from "../utils/helper";
import BeatmapStats from "../components/BeatmapStats.astro";
import OverlayLogo from "../components/OverlayLogo.astro";

---

<div class="overlay">
  <MapInfomation />
  <DifficultyStats />
  {isMania() && <ManiaStats />}
  <BeatmapStats />
  <!-- Multiple maps here -->
  <OverlayLogo />
</div>

<style>
.overlay {
  display: flex;
  font-family: 'Torus';
  width: 1920px;
  height: 102px;
  color: white;
  display: flex;
  /* border: 1pt solid white; */
}
</style>
